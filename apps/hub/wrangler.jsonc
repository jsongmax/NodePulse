{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nodepulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/s/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "Hub",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Hub"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nodepulse",
      "database_id": "local-nodepulse-db",
    },
  ],
  "ratelimits": [
    {
      "name": "RL_AUTH",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "RL_AGENT",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "RL_API",
      "namespace_id": "1003",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "TOKEN_PEPPER": "local_dev_pepper_32_bytes_random_dev_val",
  },
}
